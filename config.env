CONFIG_ENV=config.env

# Kernel info (使用适配 Android 12 的社区源码)
KERNEL_SOURCE=https://github.com/Jbub5/android_kernel_xiaomi_mt6768
KERNEL_SOURCE_BRANCH=merlin
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ARCH=arm64

# KernelSU / ReSukiSU 配置
# 1. 开启集成开关，让脚本处理核心代码注入
ENABLE_KERNELSU=true
# 2. 指向 ReSukiSU 的官方 setup 脚本，而非原版 KernelSU
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/main/kernel/setup.sh
# 3. 对于非 GKI 的 4.14 内核，可能需要回退不支持非 GKI 的提交
KSU_REVERT=true
# 4. 开启 KPROBES 配置，这是 ReSukiSU 在 4.14 内核上的主要 Hook 方式
ADD_KPROBES_CONFIG=true
# 5. 如果 Kprobes 在你的内核上不工作，可以尝试启用这个手动 Hook 补丁 (当前保持关闭)
KSU_HOOKS_PATCH=false

# APatch 支持 (用于自动注入 KALLSYMS_ALL 等必需配置)
# 开启此项，脚本会自动将 KALLSYMS_ALL、KALLSYMS_BASE_RELATIVE 等写入 defconfig
ADD_APATCH_SUPPORT=true
FIX_APATCH_OPENELA=false

# 其他功能支持 (按需开启)
ADD_OVERLAYFS_CONFIG=false
OLD_ANDROID_SUPPORT=false

# Custom compiler (关闭极端的 Clang 21，使用默认稳妥的 AOSP Clang)
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_CUSTOM_GCC=false
USE_CUSTOM_GCC_64=true
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-gnu
USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-gnueabihf

# Standart compilers (使用较稳妥的 AOSP Clang 版本)
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
ENABLE_GCC_AOSP=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# Extra compiler options
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 LD=ld.lld AS=llvm-as AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user

# Custom AnyKernel3 (使用原作者推荐的 Merlin 专用打包器)
USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/Jbub5/AnyKernel3.git
CUSTOM_ANYKERNEL3_BRANCH=proton

# DTBO image
NEED_DTBO=false

# Build boot images (直接生成 AnyKernel3 刷机包，不重新打包 boot.img)
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# In case of problems
DISABLE_LTO=false
DISABLE_CC_WERROR=false
FIX_WIFI_SPEED=false

# Miscellaneous
REMOVE_UNUSED_PACKAGES=false
ENABLE_CCACHE=false
ADD_LOCALVERSION_TO_FILENAME=false
