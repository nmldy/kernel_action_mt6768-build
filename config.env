CONFIG_ENV=config.env

# Kernel info
KERNEL_SOURCE=https://github.com/Jbub5/android_kernel_xiaomi_mt6768
KERNEL_SOURCE_BRANCH=kernel-tree
KERNEL_CONFIG=merlin_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ARCH=arm64

# KernelSU / SukiSU 相关 —— 全部关闭，避免与 APatch 冲突
ENABLE_KERNELSU=false
KSU_REVERT=false
# 保留 true：自动写入 CONFIG_KPROBES=y / CONFIG_KALLSYMS_ALL=y，对 APatch 也有益
ADD_KPROBES_CONFIG=true
KSU_HOOKS_PATCH=false
ADD_OVERLAYFS_CONFIG=false

# APatch 支持 —— 开启，让编译脚本满足 APatch 所需内核配置
ADD_APATCH_SUPPORT=true
FIX_APATCH_OPENELA=false
OLD_ANDROID_SUPPORT=false

# Custom compiler
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_CUSTOM_GCC=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=

# Standart compilers
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
ENABLE_GCC_AOSP=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# Extra compiler options
# 已移除 CROSS_COMPILE 系列，避免与 LLVM=1 冲突
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 LD=ld.lld AS=llvm-as AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user

# Custom AnyKernel3 —— 改为 APatch 适配分支
USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/Jbub5/AnyKernel3.git
CUSTOM_ANYKERNEL3_BRANCH=ap

# DTBO image
NEED_DTBO=false

# Build boot images
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# In case of problems
DISABLE_LTO=false
# 对 4.14 + 旧 Clang 更稳，避免警告中断编译
DISABLE_CC_WERROR=true
FIX_WIFI_SPEED=false

# Miscellaneous
REMOVE_UNUSED_PACKAGES=false
ENABLE_CCACHE=false
ADD_LOCALVERSION_TO_FILENAME=false
